generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////
// ENUMS
//////////////////////////

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
  OPERATIONS
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum BusStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum TripStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  RESERVED
  PAID
  USED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  WALLET
  ONLINE
  HAND_TO_HAND
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum StopType {
  PICKUP
  DROPOFF
  BOTH
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PAYMENT
}

//////////////////////////
// USER & AUTH
//////////////////////////

model User {
  id           String        @id @default(uuid())
  email        String?       @unique
  phone        String?       @unique
  firstName    String
  lastName     String
  passwordHash String
  role         UserRole
  status       AccountStatus @default(PENDING)
  verificationLink String?
  houseAddress String?

  isDeleted    Boolean?       @default(false)
  deletedAt    DateTime?

  otpEnabled   Boolean       @default(true)
  socialAuth   Boolean       @default(false)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  driver       Driver?
  wallet       Wallet?
  tickets      Ticket[]
  payments     Payment[]
  auditLogs    AuditLog[]

  otps Otp[]
}

//////////////////////////
// DRIVER + KYC
//////////////////////////

model Driver {
  id              String   @id @default(uuid())
  userId          String   @unique

  licenseNumber   String
  licenseExpiry   DateTime
  kycVerified     Boolean  @default(false)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips           Trip[]
}

//////////////////////////
// WALLET
//////////////////////////

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Decimal  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//////////////////////////
// BUS & SEATS
//////////////////////////

model Bus {
  id          String     @id @default(uuid())
  plateNumber String     @unique
  capacity    Int
  status      BusStatus
  model       String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  seats       Seat[]
  trips       Trip[]
}

model Seat {
  id        String   @id @default(uuid())
  busId     String
  seatNo    Int

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  bus       Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@unique([busId, seatNo])
  tickets Ticket[]
}

//////////////////////////
// ROUTES & STOPS (Owerri)
//////////////////////////

model Route {
  id            String   @id @default(uuid())
  name          String
  origin        String
  destination   String
  price         Decimal
  estimatedTime Int      // minutes

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  stops         RouteStop[]
  trips         Trip[]
  promos        PromoCode[]
}

model RouteStop {
  id          String   @id @default(uuid())
  routeId     String
  name        String
  latitude    Float
  longitude   Float
  order       Int
  stopType    StopType

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
}

//////////////////////////
// TRIPS
//////////////////////////

model Trip {
  id            String     @id @default(uuid())
  routeId       String
  busId         String
  driverId      String

  departureTime DateTime
  arrivalTime   DateTime?
  status        TripStatus @default(SCHEDULED)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  route         Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)
  bus           Bus        @relation(fields: [busId], references: [id], onDelete: Cascade)
  driver        Driver     @relation(fields: [driverId], references: [id], onDelete: Cascade)

  tickets       Ticket[]
  locations     BusLocation[]
}

//////////////////////////
// REALTIME TRACKING (PER STOP)
//////////////////////////

model BusLocation {
  id        String   @id @default(uuid())
  tripId    String
  latitude  Float
  longitude Float
  etaMin    Int?     // ETA to next stop
  recordedAt DateTime @default(now())

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

//////////////////////////
// TICKETS
//////////////////////////

model Ticket {
  id         String       @id @default(uuid())
  userId     String
  tripId     String
  seatId     String

  price      Decimal
  status     TicketStatus

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip       Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seat       Seat         @relation(fields: [seatId], references: [id], onDelete: Cascade)
  payment    Payment?
}

//////////////////////////
// PAYMENTS
//////////////////////////

model Payment {
  id          String        @id @default(uuid())
  userId      String
  ticketId    String        @unique

  amount      Decimal
  method      PaymentMethod
  status      PaymentStatus
  reference   String?       @unique

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

//////////////////////////
// PROMO CODES
//////////////////////////

model PromoCode {
  id          String   @id @default(uuid())
  code        String   @unique
  discountPct Int
  routeId     String?
  expiresAt   DateTime
  isActive    Boolean  @default(true)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  route       Route?  @relation(fields: [routeId], references: [id], onDelete: Cascade)
}

//////////////////////////
// AUDIT LOGS
//////////////////////////

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  metadata  Json?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user      User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Otp {
  id           String   @id @default(uuid())
  userId       String
  codeHash     String
  attempts     Int      @default(0)
  expiresAt    DateTime
  lastSentAt   DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
